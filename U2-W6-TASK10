import java.io.*;

public class Solution {

    static int[] radius;
    static int[][] sparse;
    static int[] log;

    static void manacher(int[] a) {
        int n = a.length;
        radius = new int[n];

        int center = 0;
        int right = 0;

        for (int i = 0; i < n; i++) {
            if (i < right) {
                radius[i] = Math.min(
                    right - i,
                    radius[2 * center - i]
                );
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < n &&
                   a[i - radius[i] - 1] ==
                   a[i + radius[i] + 1]) {
                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }
    }

    static void buildSparseTable() {
        int n = radius.length;

        log = new int[n + 1];
        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        int levels = log[n] + 1;
        sparse = new int[levels][n];

        System.arraycopy(radius, 0, sparse[0], 0, n);

        for (int k = 1; k < levels; k++) {
            int len = 1 << k;
            int half = len >> 1;

            for (int i = 0; i + len <= n; i++) {
                sparse[k][i] = Math.max(
                    sparse[k - 1][i],
                    sparse[k - 1][i + half]
                );
            }
        }
    }

    static int query(int left, int right) {
        int k = log[right - left + 1];

        return Math.max(
            sparse[k][left],
            sparse[k][right - (1 << k) + 1]
        );
    }

    static int[] circularPalindromes(String s) {
        int n = s.length();

        int[] a = new int[4 * n + 1];

        for (int i = 0; i < 2 * n; i++) {
            a[2 * i + 1] = s.charAt(i % n) - 'a';
        }

        for (int i = 0; i <= 2 * n; i++) {
            a[2 * i] = 26;
        }

        manacher(a);
        buildSparseTable();

        int[] answer = new int[n];

        for (int start = 0; start < n; start++) {
            int left = 2 * start + 1;
            int right = 2 * (start + n - 1) + 1;

            int low = 1;
            int high = n;
            int best = 1;

            while (low <= high) {
                int mid = low + (high - low) / 2;

                int ql = left + mid - 1;
                int qr = right - mid + 1;

                if (ql <= qr && query(ql, qr) >= mid) {
                    best = mid;
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }

            answer[start] = best;
        }

        return answer;
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(
            new InputStreamReader(System.in)
        );

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        int[] result = circularPalindromes(s);

        StringBuilder out = new StringBuilder();

        for (int value : result) {
            out.append(value).append('\n');
        }

        System.out.print(out);
    }
}
